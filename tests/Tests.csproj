<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>LooseLipsTests</AssemblyName>
    <RootNamespace>LooseLipsTests</RootNamespace>
    <NoWarn>CS0649;CS0169</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Shims.cs" />
    <Compile Include="../src/Player2/Player2Dtos.cs" />
    <Compile Include="../src/Player2/TolerantJson.cs" />
    <!-- Pure text handling for replies that are not the object we asked for, kept free of
         game and config types so it can be held to account here. -->
    <Compile Include="../src/Player2/ReplySalvage.cs" />
    <!-- CitizenSnapshot is pure data and EffectCatalogue now depends on it, so the harness
         needs the real thing rather than a stub - a stub would let the two drift. -->
    <Compile Include="../src/Context/CitizenSnapshot.cs" />
    <Compile Include="../src/World/EffectCatalogue.cs" />
  </ItemGroup>
</Project>
